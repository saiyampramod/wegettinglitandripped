# Copy this file to .env.local and fill in the values from your Firebase
# project settings (Project settings → General → Your apps → SDK setup and
# configuration → Config). None of this is secret in the "keep it off github"
# sense — Firebase web config is meant to ship to the browser — but
# .env.local is gitignored anyway so you don't have to think about it.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
