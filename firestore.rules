rules_version = '2';

// Real accounts (Firebase Auth, email/password): each player's doc lives at
// trackers/{uid}, and only that signed-in user can write it — Firestore
// checks request.auth.uid against the doc id, so nobody can edit or wipe
// someone else's data even though everyone's progress is visible for
// competition. Reading requires being signed in at all (any account can see
// any player's doc, which is what makes the Versus leaderboard work), but
// stops fully anonymous scraping of the URL.
service cloud.firestore {
  match /databases/{database}/documents {
    match /trackers/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.name.size() < 40;
    }

    // Messages & tasks sent between players. Only the sender can create one
    // (and it must be sent as themselves); only the sender or recipient can
    // ever read, delete, or update it, and an update may only flip
    // read/done — the content, sender and recipient are immutable once sent.
    // Either side deleting is what lets "Dismiss" work for a recipient, and
    // what lets the 48h auto-cleanup run from whichever side's app is open.
    match /messages/{id} {
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid is string
                    && request.resource.data.toUid != request.auth.uid
                    && request.resource.data.type in ['message', 'task']
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() < 500;
      allow read: if request.auth != null
                  && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow update: if request.auth != null
                    && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['read', 'done', 'doneAt']);
      allow delete: if request.auth != null
                    && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
